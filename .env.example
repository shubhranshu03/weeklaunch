# Copy this file to .env.local for local development, and add the same
# values in Vercel → Project → Settings → Environment Variables.
# Never commit .env.local or paste these values in chat.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (server only — never expose it in the browser)
SUPABASE_SECRET_KEY=sb_secret_...

# Your live address (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://weeklaunch.vercel.app

# Emails that can open /admin to approve launches, separated by commas
ADMIN_EMAILS=you@example.com

# Dodo Payments → Developer → API Keys / Webhooks
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode while testing, live_mode for real payments
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Dodo Payments → Products: a one-time $29 "Premium launch" and a $19 "Launch boost"
DODO_PREMIUM_PRODUCT_ID=pdt_...
DODO_BOOST_PRODUCT_ID=pdt_...
# Dodo Payments → Products: one-time "Directory submission" packages ($49 / $99 / $149)
DODO_DIR_30_PRODUCT_ID=pdt_...
DODO_DIR_50_PRODUCT_ID=pdt_...
DODO_DIR_100_PRODUCT_ID=pdt_...
